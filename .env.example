# The enquiry API the forms post to (no trailing slash). Production: https://api.runiindustries.eu
# Empty = forms stay offline and ask the visitor to email or call (safe for previews).
VITE_API_BASE_URL=
# Cloudflare Turnstile site key: the shared widget whose hostname list includes runiindustries.eu.
# Local development can use Cloudflare's always-pass test key 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
VITE_GA_ID=
VITE_MEDIA_BASE_URL=https://media.runiindustries.eu
